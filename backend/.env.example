# ==============================================================================
# Connect4People Backend — Environment Configuration (.env)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Option A (Recommended): Connect to existing Neon PostgreSQL Cloud Database
# (Contains your 90 seeded companions, bookings, payments, and admin user)
DATABASE_URL=postgresql://neondb_owner:npg_g09xIetjhmXk@ep-square-dust-a1i8w5s6-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_SSL=true

# Option B: Local / Docker PostgreSQL (Used if DATABASE_URL is left empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=connect4people
DB_USER=postgres
DB_PASSWORD=c4p_secure_pass_2026

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=c4p_prod_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=30d

# Platform Admin Default Credentials (Used to access https://<YOUR_EC2_IP>/admin/)
ADMIN_EMAIL=admin@connect4people.com
ADMIN_PASSWORD=Admin@2026!

# ------------------------------------------------------------------------------
# Email & OTP Service (Gmail SMTP / AWS SES / Resend)
# ------------------------------------------------------------------------------
# NOTE: On AWS EC2, port 587 (TLS) and port 465 (SSL) are UNBLOCKED and work directly!
# (AWS only restricts port 25 by default to prevent spam, which we do not use).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password

# Optional: Resend HTTPS API Key (alternative cloud email delivery)
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# AWS S3 Storage (For User & Companion Profile Photo Uploads)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=connect4people-uploads

# ------------------------------------------------------------------------------
# Platform Financial Settings & UPI
# ------------------------------------------------------------------------------
PLATFORM_COMMISSION_PERCENT=20
REGISTRATION_FEE_INR=299
UPI_ID=connect4people@upi
UPI_QR_URL=https://connect4people.com/qr.png
