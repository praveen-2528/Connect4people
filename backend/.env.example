# Server
PORT=5000
NODE_ENV=development

# Database (Option 1: Single Cloud Database URL e.g. Neon.tech / Supabase / Render)
# DATABASE_URL=postgres://user:password@ep-xyz.neon.tech/connect4people?sslmode=require

# Database (Option 2: Individual variables for local / Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=connect4people
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=30d

# Gmail SMTP (for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=connect4people-uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
